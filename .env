# ─────────────────────────────────────────────────────────
# BOURSE DE CASABLANCA — Configuration locale
# ─────────────────────────────────────────────────────────

# Scraping
BOURSE_BASE_URL=https://www.casablanca-bourse.com
NEXT_BUILD_ID=k6VYoXBS432b__PEHJ2s2
REQUEST_DELAY=0.5
BULK_REQUEST_DELAY=1.0

# Cassandra (Python local → localhost | Docker interne → cassandra)
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=bourse_data
CASSANDRA_STUB=false

# Prefect
PREFECT_API_URL=http://localhost:4200/api

# Trino
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_CATALOG=cassandra
TRINO_SCHEMA=bourse_data
TRINO_USER=reporting

# Metabase
METABASE_URL=http://localhost:3000
METABASE_TRINO_HOST=trino
METABASE_TRINO_PORT=8080

# Monitoring
ANOMALY_THRESHOLD=2.0
MARKET_OPEN=09:30
MARKET_CLOSE=16:00
