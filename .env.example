# ─── Configuration Bourse de Casablanca ──────────────────────────────────────
BOURSE_BASE_URL=https://www.casablanca-bourse.com
NEXT_BUILD_ID=k6VYoXBS432b__PEHJ2s2

# ─── Configuration Cassandra ─────────────────────────────────────────────────
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=bourse_data
# Mettre CASSANDRA_STUB=true pour désactiver Cassandra (mode test uniquement)
CASSANDRA_STUB=false

# ─── Configuration Trino ─────────────────────────────────────────────────────
TRINO_HOST=localhost
TRINO_PORT=8080

# ─── Configuration Prefect ───────────────────────────────────────────────────
PREFECT_API_URL=http://localhost:4200/api

# ─── Paramètres de scraping ──────────────────────────────────────────────────
REQUEST_DELAY=0.5
BULK_REQUEST_DELAY=1.0

# ─── Instruments suivis (détails + historique) ────────────────────────────────
# 10 instruments: ATW, BCP, IAM, MNG, ADH, CIH, ALM, DHO, HPS, ATH
TRACKED_INSTRUMENTS=ATW,BCP,IAM,MNG,ADH,CIH,ALM,DHO,HPS,ATH