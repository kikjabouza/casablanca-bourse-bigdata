# ─────────────────────────────────────────────────────────
# BOURSE DE CASABLANCA — Variables d'environnement
# Copier ce fichier en .env et adapter si nécessaire :
#   copy .env.example .env
# ─────────────────────────────────────────────────────────

# ── Scraping ─────────────────────────────────────────────
BOURSE_BASE_URL=https://www.casablanca-bourse.com
NEXT_BUILD_ID=k6VYoXBS432b__PEHJ2s2
REQUEST_DELAY=0.5
BULK_REQUEST_DELAY=1.0

# ── Cassandra ─────────────────────────────────────────────
# Depuis l'hôte (Python local) : localhost
# Depuis un container Docker   : cassandra
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=bourse_data
CASSANDRA_STUB=false
# CASSANDRA_USERNAME=
# CASSANDRA_PASSWORD=

# ── Prefect ───────────────────────────────────────────────
PREFECT_API_URL=http://localhost:4200/api

# ── Trino (requêtes SQL / JDBC Metabase) ──────────────────
# Depuis l'hôte : localhost:8080
# Depuis Metabase (Docker) : trino:8080
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_CATALOG=cassandra
TRINO_SCHEMA=bourse_data
TRINO_USER=reporting

# ── Metabase ──────────────────────────────────────────────
METABASE_URL=http://localhost:3000
METABASE_TRINO_HOST=trino
METABASE_TRINO_PORT=8080

# ── Monitoring intraday ───────────────────────────────────
ANOMALY_THRESHOLD=2.0
MARKET_OPEN=09:30
MARKET_CLOSE=16:00
